# 📊 Sales Data Analysis with Python

# Step 1: Import libraries
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set plot style
sns.set(style='whitegrid')

# Step 2: Load the dataset
df = pd.read_csv('sales_data.csv')  # Make sure this file is in the same folder

# Step 3: Basic data check
print("🧾 Data Overview:")
print(df.head())
print("\n📊 Summary Statistics:")
print(df.describe())
print("\n🔍 Missing Values:")
print(df.isnull().sum())

# Step 4: Clean the data (Example: remove nulls)
df.dropna(inplace=True)

# Step 5: Add extra columns (e.g., extract month if 'Date' exists)
if 'Date' in df.columns:
    df['Date'] = pd.to_datetime(df['Date'])
    df['Month'] = df['Date'].dt.month_name()

# Step 6: Visualize top-selling products
plt.figure(figsize=(10, 5))
top_products = df['Product'].value_counts().head(5)
sns.barplot(x=top_products.index, y=top_products.values, palette='viridis')
plt.title('Top 5 Selling Products')
plt.ylabel('Units Sold')
plt.xlabel('Product')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# Step 7: Sales trend by month (if date column exists)
if 'Month' in df.columns:
    monthly_sales = df.groupby('Month')['Sales'].sum().sort_index()
    plt.figure(figsize=(10, 5))
    monthly_sales.plot(kind='line', marker='o')
    plt.title('Monthly Sales Trend')
    plt.ylabel('Sales')
    plt.xlabel('Month')
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

